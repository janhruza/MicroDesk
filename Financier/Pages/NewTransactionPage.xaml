<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Financier.Pages.NewTransactionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Financier.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Tag="New Transaction">

    <Grid Padding="32,24,32,32" RowSpacing="28" MaxWidth="1280" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="tbTitle" Style="{ThemeResource PageTitleStyle}"/>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Style="{ThemeResource CardStyle}"
                Padding="48"
                MinWidth="760"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="28" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CalendarDatePicker Name="dpDate"
                                    Header="Date"
                                    MinHeight="56"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    FirstDayOfWeek="Monday"/>

                <ComboBox Grid.Column="1"
                          Name="cbxCategory"
                          Header="Category"
                          MinHeight="56"
                          HorizontalContentAlignment="Stretch"
                          HorizontalAlignment="Stretch"/>

                <NumberBox Grid.Row="1"
                           Name="txtValue"
                           Header="Amount"
                           Value="0"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="1"
                           MinHeight="56"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="Use a positive amount. Financier applies your selected category and date to this entry."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Row="2"
                         Grid.ColumnSpan="2"
                         Name="txtNote"
                         Header="Note (Optional)"
                         PlaceholderText="Add a description..."
                         AcceptsReturn="True"
                         MinHeight="200"
                         HorizontalContentAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="btnSave"
                    Content="Save Transaction" 
                    Style="{ThemeResource PrimaryActionButtonStyle}"
                    Click="btnSave_Click"/>
            
            <Button x:Name="btnClear"
                    Content="Clear" 
                    Style="{ThemeResource SecondaryActionButtonStyle}"
                    Click="btnClear_Click"/>
        </StackPanel>
    </Grid>
</Page>
