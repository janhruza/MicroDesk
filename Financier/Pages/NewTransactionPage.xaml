<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Financier.Pages.NewTransactionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Financier.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Tag="New Transaction">

    <Grid Padding="24,20,24,24" RowSpacing="20" MaxWidth="1280" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="tbTitle" Style="{ThemeResource PageTitleStyle}"/>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Style="{ThemeResource CardStyle}"
                Padding="28"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch">

            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                <CalendarDatePicker Name="dpDate"
                                    Header="Date"
                                    MinHeight="48"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    FirstDayOfWeek="Monday"/>

                <ComboBox Name="cbxCategory"
                          Header="Category"
                          MinHeight="48"
                          HorizontalContentAlignment="Stretch"
                          HorizontalAlignment="Stretch"/>

                <NumberBox Name="txtValue"
                           Header="Amount"
                           Value="0"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="1"
                           MinHeight="48"
                           HorizontalContentAlignment="Stretch"
                           HorizontalAlignment="Stretch"/>

                <TextBlock
                           Text="Use a positive amount. Financier applies your selected category and date to this entry."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <TextBox Name="txtNote"
                         Header="Note (Optional)"
                         PlaceholderText="Add a description..."
                         AcceptsReturn="True"
                         MinHeight="140"
                         HorizontalContentAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="btnSave"
                    Content="Save Transaction" 
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="btnSave_Click"/>
            
            <Button x:Name="btnClear"
                    Content="Clear" 
                    Click="btnClear_Click"/>
        </StackPanel>
    </Grid>
</Page>
