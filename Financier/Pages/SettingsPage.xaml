<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Financier.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Financier.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Tag="Settings">

    <Grid Padding="36,32,36,36" RowSpacing="28" MaxWidth="1280" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" Style="{ThemeResource PageTitleStyle}"/>
            <TextBlock Text="Tune the appearance of your workspace" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="32" MaxWidth="920" HorizontalAlignment="Stretch">
                
                <!-- Appearance Group -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{ThemeResource SectionTitleStyle}"/>
                    
                    <Border Style="{ThemeResource CardStyle}" Padding="32">
                        <StackPanel Spacing="20">
                            <ComboBox Name="cbxThemeMode"
                                      Header="App Theme"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="cbxThemeMode_SelectionChanged">
                                <ComboBoxItem Content="Light" Tag="themeLight"/>
                                <ComboBoxItem Content="Dark" Tag="themeDark"/>
                                <ComboBoxItem Content="System" Tag="themeSystem"/>
                            </ComboBox>

                            <ComboBox Name="cbxBackdrop"
                                      Header="Window Backdrop"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="cbxBackdrop_SelectionChanged">
                                <ComboBoxItem Content="Mica" Tag="backdropMica"/>
                                <ComboBoxItem Content="Mica Alt" Tag="backdropMicaAlt"/>
                                <ComboBoxItem Content="Acrylic" Tag="backdropAcrylic"/>
                                <ComboBoxItem Content="None" Tag="backdropNone"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About Group -->
                <StackPanel Spacing="12">
                    <TextBlock Text="About" Style="{ThemeResource SectionTitleStyle}"/>
                    <Border Style="{ThemeResource CardStyle}" Padding="32">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Financier" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Version 1.0.0" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock Text="A simple personal finance manager built with WinUI 3." Style="{ThemeResource BodyTextBlockStyle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
