<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Financier.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Financier.Pages"
    xmlns:core="using:Financier.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Tag="Dashboard">

    <Grid RowSpacing="20" Padding="24,20,24,24" MaxWidth="1560" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Style="{ThemeResource PageTitleStyle}">
                <Run Text="Welcome back,"/>
                <Run x:Name="rUsername" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </TextBlock>
            <TextBlock Text="Here is your financial snapshot" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7"/>
        </StackPanel>

        <!-- Balance Card -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Style="{ThemeResource CardStyle}"
                Padding="24">
            <Grid ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CURRENT POSITION" Style="{ThemeResource MutedCaptionStyle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Your total balance" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.75" Margin="0,0,0,4"/>
                <TextBlock x:Name="tbBalance" 
                            Style="{ThemeResource MetricValueStyle}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="88"
                        Height="88"
                        CornerRadius="44"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.18"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8C7;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="34"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Recent activity" Style="{ThemeResource CardHeaderStyle}"/>
            
            <Grid Grid.Row="1">
                <ListView x:Name="lvHistory"
                          Style="{ThemeResource ListSurfaceStyle}"
                          SelectionChanged="lvHistory_SelectionChanged"
                          MinHeight="320">
                
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:TransactionInfo">
                        <Grid Padding="12,10" ColumnSpacing="16" MinHeight="64">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Edit"
                                                    Tag="{x:Bind}"
                                                    Click="transactionEditMenuItem_Click"/>
                                    <MenuFlyoutItem Text="Delete"
                                                    Tag="{x:Bind}"
                                                    Click="transactionDeleteMenuItem_Click"/>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="IconBorder"
                                    Width="40" Height="40"
                                    CornerRadius="20" 
                                    VerticalAlignment="Center">
                                <FontIcon x:Name="TypeIcon" 
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="18"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="CategoryText" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{x:Bind Timestamp.ToShortDateString()}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            </StackPanel>

                            <TextBlock x:Name="ValueText" 
                                       Grid.Column="2" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="16"
                                       TextAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="stpEmptyHistory"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8C7;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="28"
                              Opacity="0.55"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtEmptyHistory"
                               Text="No transactions yet"
                               Style="{ThemeResource CardHeaderStyle}"
                               HorizontalTextAlignment="Center"/>
                    <TextBlock Text="Your income and expenses will appear here."
                               Style="{ThemeResource MutedCaptionStyle}"
                               HorizontalTextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Detail Preview -->
        <Border Grid.Row="2" Grid.Column="1"
                Margin="12,0,0,0"
                Style="{ThemeResource CardStyle}"
                VerticalAlignment="Top">
                <Grid>
                    <StackPanel x:Name="stpEmptyPreview"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="32"
                                  Opacity="0.55"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a transaction"
                                   Style="{ThemeResource CardHeaderStyle}"
                                   HorizontalTextAlignment="Center"/>
                        <TextBlock Text="Choose an item to see its details and actions."
                                   Style="{ThemeResource MutedCaptionStyle}"
                                   TextWrapping="Wrap"
                                   HorizontalTextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="stpPreview"
                                Spacing="16"
                                Visibility="Collapsed">
                <TextBlock Text="Transaction details" Style="{ThemeResource CardHeaderStyle}"/>
                
                <StackPanel>
                    <TextBlock Text="Date" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock x:Name="txtDateDisplay" FontSize="16"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Amount" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock x:Name="txtValueDisplay" FontSize="24" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Category" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock x:Name="txtCategoryDisplay" FontSize="16"/>
                </StackPanel>

                <StackPanel x:Name="spNotes">
                    <TextBlock Text="Notes" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock x:Name="txtNotesDisplay" FontSize="14" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="btnEditTransaction"
                            Content="Edit"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="btnEditTransaction_Click"/>
                    <Button x:Name="btnDeleteTransaction"
                            Content="Delete"
                            Click="btnDeleteTransaction_Click"/>
                </StackPanel>
                    </StackPanel>
                </Grid>
        </Border>
    </Grid>
</Page>
