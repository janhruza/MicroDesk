<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Update.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Update"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Update">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
                  Name="titleBar"
                  Title="Update"
                  Subtitle="RSS Feed"
                  IsBackButtonEnabled="False"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  BackRequested="titleBar_BackRequested"
                  PaneToggleRequested="titleBar_PaneToggleRequested">

            <!--App icon-->
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.png"/>
            </TitleBar.IconSource>


            <TitleBar.Content>

                <StackPanel Orientation="Horizontal"
                            Spacing="8">

                    <AutoSuggestBox QueryIcon="Find"
                                    AutomationProperties.Name="Search"
                                    PlaceholderText="Search RSS Feeds"/>

                    <Button ToolTipService.ToolTip="Add New Feed"
                            Click="btnNewFeed_Click">

                        <SymbolIcon Symbol="Add"/>
                    </Button>

                </StackPanel>

            </TitleBar.Content>

        </TitleBar>

        <NavigationView Grid.Row="2"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        Name="nvMenu"
                        IsSettingsVisible="True"
                        SelectionChanged="nvMenu_SelectionChanged">

            <NavigationView.ContextFlyout>

                <MenuFlyout>

                    <MenuFlyoutItem Text="Add New Feed"
                                    Icon="Add"
                                    KeyboardAcceleratorTextOverride="Ctrl+N"
                                    Click="btnNewFeed_Click"/>

                </MenuFlyout>

            </NavigationView.ContextFlyout>

            <NavigationView.MenuItems>

            </NavigationView.MenuItems>

            <ScrollViewer>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <InfoBar Grid.Row="0"
                             Name="infoBar"
                             Severity="Informational"
                             Message="No message."
                             Title="Info"
                             IsOpen="False"/>

                    <Frame Grid.Row="1"
                           Margin="16"
                           Name="frm"/>
                </Grid>
                
            </ScrollViewer>

        </NavigationView>

    </Grid>
</Window>
